{
  "name": "prism-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs --local",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build": "node scripts/build.mjs",
