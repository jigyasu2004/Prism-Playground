    "test:edges": "node tests/browser-edges.mjs",
    "test:timing": "node tests/browser-timing.mjs",
    "test:flows": "node tests/browser-flows.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2"
  }
}
