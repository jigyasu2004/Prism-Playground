# Set true only for public guest gameplay.
PUBLIC_ACCESS=false
# No secrets are required for local development. Production requires secure setup.
PORT=4317
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
DB_PATH=/persistent/prism/prism.sqlite
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_ALLOWED_SUBJECTS=
